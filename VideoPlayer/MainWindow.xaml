<mah:MetroWindow x:Class="WebSiteRatings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:utils="clr-namespace:VideoPlayer.Utils"
        xmlns:SVG="http://sharpvectors.codeplex.com/svgc/"
        Loaded="MetroWindow_Loaded"
        mc:Ignorable="d"
        Title="My Sites" Height="650" Width="1000">
    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/icons.xaml"></ResourceDictionary>
                <ResourceDictionary Source="Resources/PlayerStyles.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SvgPop" TargetType="{x:Type SVG:SvgViewbox}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}" Value="True">
                        <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <utils:OrConverter x:Key="MultiOrConverter" />
        </ResourceDictionary>
    </mah:MetroWindow.Resources>
    <Grid>
        <Popup x:Name="VolumePopup"
                            Placement="Top"
                            PlacementTarget="{Binding Source={x:Reference VolumeMute}}"
                            Width="{Binding Source={x:Reference VolumeMute}, Path=ActualWidth}"
                            MinHeight="100"
                            PopupAnimation="Fade"
                            StaysOpen="True"
                            DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                        >
            <Popup.IsOpen>
                <MultiBinding Converter="{StaticResource MultiOrConverter}">
                    <Binding ElementName="VolumeMute" Path="IsMouseOver" Mode="OneWay" />
                    <Binding ElementName="VolumeMin" Path="IsMouseOver" Mode="OneWay" />
                    <Binding ElementName="VolumeMed" Path="IsMouseOver" Mode="OneWay" />
                    <Binding ElementName="VolumeMax" Path="IsMouseOver" Mode="OneWay" />
                    <Binding ElementName="VolumePopup" Path="IsMouseOver" Mode="OneWay" />
                </MultiBinding>
            </Popup.IsOpen>
            <Border BorderThickness="1">
                <TextBlock Name="myPopupText" Background="LightBlue" Foreground="Blue">
                Popup Text
                </TextBlock>
            </Border>
        </Popup>
        <vlc:VideoView x:Name="VideoView" Background="Black">
            
            <!--<DockPanel>
                <Border Height="25" Background="SkyBlue" BorderBrush="Black" BorderThickness="1" DockPanel.Dock="Top">
                    <TextBlock Foreground="Black">Dock = "Top"</TextBlock>
                </Border>
               
                <Button DockPanel.Dock="Bottom" Click="Play_Clicked" Width="16" Height="16">
                    <Image Source="{StaticResource playDrawingImage}" />
                </Button>
                <Border Width="200" Background="PaleGreen" BorderBrush="Black" BorderThickness="1" DockPanel.Dock="Left">
                    <TextBlock Foreground="Black">Dock = "Left"</TextBlock>
                </Border>
                <Border Background="White" BorderBrush="Black" BorderThickness="1">
                    <TextBlock Foreground="Black">This content will "Fill" the remaining space</TextBlock>
                </Border>
                
            </DockPanel>-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <StackPanel>

                </StackPanel>
                <Grid Grid.Row="1" Height="100">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                

                    <Slider Grid.Row="1" x:Name="TimeSlider" Style="{StaticResource Horizontal_Slider}" VerticalAlignment="Center" IsMoveToPointEnabled="True" Value="500" Margin="10,0,10,0"></Slider>

                    
                    <Grid x:Name="ButtonRow"  Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        

                        <Button x:Name="PlayBtn" Style="{StaticResource TransparentButton}" Grid.Column="0" Click="Play_Clicked">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/play.svg" OptimizePath="False" TextAsGeometry="True" MessageBackground="White"/>
                        </Button>

                        <Button x:Name="StopBtn" Style="{StaticResource TransparentButton}" Grid.Column="0" Click="Play_Clicked">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/stop.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource TransparentButton}" Click="Backward_Clicked">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/10-back.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource TransparentButton}" Click="Forward_Clicked">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/10-forward.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>

                        <Button x:Name="VolumeMute" Grid.Column="3" Style="{StaticResource TransparentButton}" Click="Mute_Clicked">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/sound-mute.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>
                        <Button x:Name="VolumeMin"  Grid.Column="3" Style="{StaticResource TransparentButton}" Click="Mute_Clicked" Visibility="Hidden">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/sound-min.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>
                        <Button x:Name="VolumeMed" Grid.Column="3" Style="{StaticResource TransparentButton}" Click="Mute_Clicked" Visibility="Hidden">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/sound-med.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>
                        <Button x:Name="VolumeMax" Grid.Column="3" Style="{StaticResource TransparentButton}" Click="Mute_Clicked" Visibility="Hidden">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/sound-max.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Foreground="White" Margin="0 0 5 0">Narutoo</TextBlock>
                            <TextBlock Foreground="White" FontWeight="Bold" Margin="0 0 7 0">EP 275</TextBlock>
                            <TextBlock Foreground="White">Bowlcut faints and cries</TextBlock>
                        </StackPanel>
                        <Button x:Name="NextTrackBtn" Grid.Column="5" Style="{StaticResource TransparentButton}" Click="NextTrack">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/next.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>
                        <Button x:Name="EpisodesBtn" Grid.Column="6" Style="{StaticResource TransparentButton}">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/episodes.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>
                        <Button x:Name="SubtitlesBtn" Grid.Column="8" Style="{StaticResource TransparentButton}">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/subtitles.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>
                        <Button x:Name="SpeedBtn" Grid.Column="9" Style="{StaticResource TransparentButton}">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/speed.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>
                        <Button x:Name="FullscreenBtn" Grid.Column="10" Style="{StaticResource TransparentButton}" Click="FullscreenToggle">
                            <SVG:SvgViewbox Style="{StaticResource SvgPop}" Source="/Assets/Icons/fullscreen.svg" OptimizePath="False" TextAsGeometry="True"/>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </vlc:VideoView>
    </Grid>
</mah:MetroWindow>
