<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Popcorn.Player.Linux</RootNamespace>
    <!-- Function pointers / LibraryImport for libpopcorn_player.so (Native/PlayerNative.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Utils\**" />
    <EmbeddedResource Remove="Utils\**" />
    <None Remove="Utils\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFMpegCore" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Popcorn.Player.Core\Popcorn.Player.Core.csproj" />
  </ItemGroup>


  <!-- The overlay (Popcorn.Web/dist-player, `npm run build:player` there) as web-player/: added as content in a target
       (globbed when building, not when the project is loaded), so both the build output and `dotnet publish` get it. -->
  <Target Name="IncludeWebPlayer" BeforeTargets="BeforeBuild">
    <!-- Replace, not merge: file names are content-hashed, old bundles would pile up. -->
    <RemoveDir Directories="$(OutDir)web-player" />
    <ItemGroup>
      <WebPlayerFile Include="..\Popcorn.Web\dist-player\**\*.*" />
      <Content Include="@(WebPlayerFile)" Link="web-player\%(WebPlayerFile.RecursiveDir)%(WebPlayerFile.Filename)%(WebPlayerFile.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>