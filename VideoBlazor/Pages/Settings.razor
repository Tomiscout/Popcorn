
@page "/settings"
@using VideoBlazor.PlayerServer
@using VideoBlazor.Core.Services
@inject FolderService FolderService

<h1>Settings</h1>

<MudButton OnClick="StartPlayer">Start test player</MudButton>
<MudButton Variant="Variant.Filled" @onclick="OpenRootFolder">
    <span>Open root folder</span>
</MudButton>

@code {
    public async Task StartPlayer()
    {
        Task.Run(async () => await ServerPipeManager.StartServer()).ConfigureAwait(false);
        PlayerUtils.LaunchPlayer();
    }

    public void OpenRootFolder()
    {
        FolderService.OpenRootFolderExplorer();
    }
}