
@page "/settings"
@using VideoBlazor.Domain.Models;
@using VideoBlazor.Persistence;
@using VideoBlazor.PlayerServer
@using VideoBlazor.Core.Services
@using VideoBlazor.Shared.Utils;
@inject FolderService FolderService
@inject SettingsRepository SettingsRepository

<h1>Settings</h1>

<MudButton OnClick="StartPlayer">Start test player</MudButton>
<MudButton Variant="Variant.Filled" @onclick="OpenRootFolder">
    <span>Open root folder</span>
</MudButton>

<br />
<div>
    @if(_settings != null)
    {
        <MudSwitch @bind-Checked="@_settings.UseInternalPlayer" Label="Use internal media player" Color="Color.Tertiary" />
        <MudSwitch @bind-Checked="@_settings.UseInternalTorrentClient" Label="Use internal torrent client" Color="Color.Tertiary" />
        <MudButton OnClick="SaveSettings">Save settings</MudButton>
    }
</div>

@code {
    private SettingsModel _settings;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsRepository.GetSettings();
    }

    public async Task StartPlayer()
    {
        PlayerUtils.LaunchPlayer(@"C:\Users\brazi\Downloads\Enchanted (2007) [BluRay] [1080p] [YTS.AM]\Enchanted.2007.1080p.BluRay.x264-[YTS.AM].mp4");
    }

    public void OpenRootFolder()
    {
        FolderService.OpenRootFolderExplorer();
    }

    public async Task SaveSettings()
    {
        await SettingsRepository.SaveSettings(_settings);
    }
}