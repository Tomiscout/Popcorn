@using MonoTorrent.Client;
@using VideoBlazor.Core.Model
@using VideoBlazor.Core.Services;
@using VideoBlazor.Core;
@using VideoBlazor.Core.Enums;
@using VideoBlazor.Platforms.Windows
@using VideoBlazor.Shared.Extensions;
@using VideoBlazor.Shared.Utils;
@using VideoBlazor.Torrent.Model
@using VideoBlazor.Torrents
@inject TorrentCore _torrentCore;
@inject FolderService _folderService

@page "/addTorrent"


<MudDialog>
    <DialogContent>
        <div style="min-width: 550px; height:100%; display:flex; flex-direction: column;">
            <div style="width:100%;">
                <div style="padding: 2px;">
                    @if (fetchingMetadata)
                    {
                        <span>Fetching metadata...</span>
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    }
                    else if (torrentManager == null)
                    {
                        <span>Failed to get metadata</span>
                    }
                    else
                    {
                        <div class="d-flex flex-column">
                            <MudText><b>Size:</b> @GetTorrentSizeText()</MudText>

                            @if (!string.IsNullOrWhiteSpace(torrentManager?.Torrent?.Publisher))
                            {
                                <MudText><b>Publisher:</b> @torrentManager.Torrent.Publisher</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(torrentManager?.Torrent?.Comment))
                            {
                                <MudText><b>Comment:</b> @torrentManager.Torrent.Comment</MudText>
                            }
                        </div>
                    }
                </div>
                <MudCard>
                    <MudCardContent>
                        <EditForm Model="@inputData" OnValidSubmit="HandleValidSubmit">
                            <MudTextField Label="Title" Disabled="@fetchingMetadata" ReadOnly="true"
                                          @bind-Value="inputData.Title" For="@(() => inputData.Title)" />
                            <div style="display: flex;flex-direction: row;align-items: center;">
                                <div style="flex-grow:1">
                                    <MudTextField Label="Download directory" Class="mt-3"
                                                  @bind-Value="inputData.DownloadDirectory" For="@(() => inputData.DownloadDirectory)" />
                                </div>
                                
                                <span class="search-right ml-2" @onclick="() => SelectDownloadFolder()"><i class="fa fa-2x fa-folder"></i></span>
                            </div>
                                          
                        </EditForm>
                    </MudCardContent>
                </MudCard>
            </div>
            <div style="margin-top: 4px;width:100%;">
                <MudCard>
                    <MudCardContent>
                        <div>
                            <MudButton>Select All</MudButton>
                            <MudButton>Select None</MudButton>
                        </div>
                        <MudTreeView Items="@TreeItems">
                            <ItemTemplate>
                                <MudTreeViewItem @bind-Expanded="@context.IsExpanded" Items="@context.TreeItems">
                                    <Content>
                                        <MudTreeViewItemToggleButton @bind-Expanded="@context.IsExpanded" Visible="@context.HasChild" />
                                        <MudCheckBox T="bool?" Checked="@(context.HasPartialChildSelection() ? null : context.IsChecked)" CheckedChanged="@((e) => CheckedChanged(context))"></MudCheckBox>
                                        <MudIcon Icon="@context.Icon" Class="ml-0 mr-2" Color="@Color.Default" />
                                        <MudText>@context.Text</MudText>
                                    </Content>
                                </MudTreeViewItem>
                            </ItemTemplate>
                        </MudTreeView>
                    </MudCardContent>
                </MudCard>
            </div>
        </div>
        
        
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Download</MudButton>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public TorrentAddModel? inputData { get; set; }
    HashSet<FileTreeNode> SelectedFiles { get; set; }
    private HashSet<FileTreeNode> TreeItems { get; set; } = new HashSet<FileTreeNode>();

    TorrentManager? torrentManager = null;
    bool success;
    bool fetchingMetadata = false;

    protected override async Task OnInitializedAsync()
    {
        fetchingMetadata = true;
        StateHasChanged();

        //Maybe syntax could be improved, but this works for now
#pragma warning disable CS4014
        _torrentCore.StartMetadataFetch(inputData.Id)
         .ContinueWith(s => HandleMetadataReceived(s.Result), TaskContinuationOptions.OnlyOnRanToCompletion)
         .ContinueWith(t => Console.WriteLine(t.Exception), TaskContinuationOptions.OnlyOnFaulted);
        //TODO log properly
#pragma warning restore CS4014
    }

    public async Task HandleValidSubmit()
    {
        success = true;
        await _torrentCore.SubmitTorrentAdd(inputData);
        MudDialog.Close(DialogResult.Ok(true));
    }

    void HandleMetadataReceived(TorrentManager manager)
    {
        fetchingMetadata = false;
        torrentManager = manager;

        TreeItems = BuildFileTree(manager.Files);

        Application.Current?.MainPage?.Dispatcher.Dispatch(() => StateHasChanged());
    }

    string GetTorrentSizeText()
    {
        var torrentSize = StringUtils.FormatBytes(torrentManager.Torrent.Size);
        var remainingSpace = GetTotalFreeSpace(inputData.DownloadDirectory.Substring(0, 1));
        if(remainingSpace != -1)
        {
            torrentSize += $" (Free space on disk:{StringUtils.FormatBytes(remainingSpace)})";
        }
        return torrentSize;
    }

    async Task SelectDownloadFolder()
    {
        var result = await _folderService.OpenFolderPicker();
        if (result == null) return;

        inputData.DownloadDirectory = result;
    }

    async Task Cancel()
    {
        await _torrentCore.RemoveTorrent(inputData.Id);
        MudDialog.Cancel();
    }

    private long GetTotalFreeSpace(string driveLetter)
    {
        foreach (DriveInfo drive in DriveInfo.GetDrives())
        {
            if (drive.IsReady && drive.Name.StartsWith(driveLetter))
            {
                return drive.TotalFreeSpace;
            }
        }
        return -1;
    }

    protected void CheckedChanged(FileTreeNode item)
    {
        item.IsChecked = !item.IsChecked;
        // checked status on any child items should mirrror this parent item
        if (item.HasChild)
        {
            foreach (FileTreeNode child in item.TreeItems)
            {
                child.IsChecked = item.IsChecked;
            }
        }
        // if there's a parent and all children are checked/unchecked, parent should match
        if (item.Parent != null)
        {
            item.Parent.IsChecked = !item.Parent.TreeItems.Any(i => !i.IsChecked);
        }
    }

    public static HashSet<FileTreeNode> BuildFileTree(IList<ITorrentFileInfo> torrentFiles, string rootNodeName = "", char separator = '\\')
    {
        var rootNode = new FileTreeNode(rootNodeName);
        foreach (var torrentFile in torrentFiles.Where(x => !string.IsNullOrEmpty(x.Path.Trim())))
        {
            var currentNode = rootNode;
            var pathItems = torrentFile.Path.Split(separator);
            foreach (var (item, index) in pathItems.WithIndex())
            {
                var tmp = currentNode.TreeItems.Where(x => x.Text.Equals(item));

                if(tmp.Count() > 0)
                {
                    currentNode = tmp.Single();
                }
                else if (pathItems.Length == index + 1)
                {
                    var newNode = new FileTreeNode(item, torrentFile);
                    if (currentNode != rootNode)
                    {
                        newNode.Parent = currentNode;
                    }
                    currentNode.TreeItems.Add(newNode);
                }
                else
                {
                    var newNode = new FileTreeNode(item);
                    if(currentNode != rootNode)
                    {
                        newNode.Parent = currentNode;
                    }
                    currentNode.TreeItems.Add(newNode);
                    currentNode = newNode;
                }
            }
        }
        return rootNode.TreeItems;
    }

    public class FileTreeNode
    {
        public string Text { get; set; }

        public string Icon { get; set; }

        public string Path { get; set; }

        public string Size { get; set; }

        public ITorrentFileInfo? TorrentFile { get; set; }

        public bool IsExpanded { get; set; } = true;
        
        public bool IsChecked { get; set; } = true;

        public FileTreeNode Parent { get; set; }

        public bool HasChild => TreeItems != null && TreeItems.Count > 0;

        public HashSet<FileTreeNode> TreeItems { get; set; } = new HashSet<FileTreeNode>();

        public FileTreeNode(string text)
        {
            Text = text;
            Icon = Icons.Material.Filled.Folder;
        }

        public FileTreeNode(string text, ITorrentFileInfo torrentFile)
        {
            Text = text;
            Path = torrentFile.FullPath;
            Size = StringUtils.FormatBytes(torrentFile.Length);
            TorrentFile = torrentFile;
            Icon = Icons.Custom.FileFormats.FileDocument;
        }

        public bool HasPartialChildSelection()
        {
            int iChildrenCheckedCount = (from c in TreeItems where c.IsChecked select c).Count();
            return HasChild && iChildrenCheckedCount > 0 && iChildrenCheckedCount < TreeItems.Count();
        }
    }
}