@page "/search"
@using System.Diagnostics
@using DM.MovieApi.MovieDb.Movies
@using VideoBlazor.Core.Enums
@using VideoBlazor.Core.Model
@using VideoBlazor.Core.Utils
@using VideoBlazor.SearchProviders.Model
@using VideoBlazor.SearchProviders
@using VideoBlazor.SearchProviders.Models
@using VideoBlazor.SearchProviders.MovieDb
@using VideoBlazor.SearchProviders.Utils
@using VideoBlazor.SearchProviders.Enum

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Torrents">

        <MudTextField @bind-Value="@searchInput" Label="Standard" Variant="Variant.Text"></MudTextField>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="SearchQuery">Search</MudButton>

        <MudList Clickable="true">
            <MudDivider />
            @foreach (var item in searchResults)
            {
                <div class="search-list-item">
                    @switch (item.Source)
                    {
                        case SearchSourceType.PirateBay:
                            <img class="source-img" src="/images/piratebay.svg" />
                            break;
                        case SearchSourceType.Rarbg:
                            <img class="source-img" src="/images/rarbg.png" />
                            break;
                        default:
                            <div class="source-img" />
                            break;
                    }
                    <span class="search-title">@item.Title</span>
                    @if (!string.IsNullOrWhiteSpace(item.MagnetLink) || !string.IsNullOrWhiteSpace(item.TorrentFileLink))
                    {
                        <span class="search-right mr-2" @onclick="() => DownloadTorrent(item)"><i class="fa fa-magnet"></i></span>
                    }
                    <span class="search-right seeds mr-2">@item.Seeds</span>
                    <span class="search-right peers mr-2">@item.Peers</span>
                </div>
                <MudDivider />
            }
        </MudList>
    </MudTabPanel>

    <MudTabPanel Text="Media">
        <MudTextField @bind-Value="@mediaSearchInput" Label="Standard" Variant="Variant.Text"></MudTextField>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="SearchMediaQuery">Search</MudButton>

        <MudList Clickable="true">
            <MudDivider />
            @foreach (var item in mediaSearchResults)
            {
                <div class="media-list-item">
                    @if (item.MediaType == MovieDbMediaType.Person)
                    {
                        if(string.IsNullOrWhiteSpace(item.ProfilePath)) {
                            <img src="/images/image-missing.svg" />
                        } else {
                            <img class="media-poster-img" src="@item.ProfilePath" />
                        }
                    } else {
                        if(string.IsNullOrWhiteSpace(item.PosterPath)) {
                            <img src="/images/image-missing.svg" />
                        } else {
                            <img class="media-poster-img" src="@item.PosterPath" />
                        }
                    }
                    <div class="media-info-container">
                        <div style="display: flex; flex-direction: row;">
                            <span class="media-title">@item.Title</span>
                            @if(item.MediaType == MovieDbMediaType.Movie) {
                                <MudChip Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">Movie</MudChip>
                            } else if(item.MediaType == MovieDbMediaType.TvShow) {
                                <MudChip Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">TV show</MudChip>
                            } else {
                                <MudChip Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">Person</MudChip>
                            }
                        </div>
                        <span class="media-description">@item.Description</span>
                        <div>
                            @foreach (var genre in item.Genres)
                            {
                                <MudChip Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">@genre</MudChip>
                            }
                        </div>
                    </div>
                </div>
                <MudDivider />
            }
        </MudList>
    </MudTabPanel>
</MudTabs>



<MudPopover Open="@_isSearching" Fixed="true" Class="pa-4 status-popover" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.BottomRight">
    <div class="status-container">
        @foreach (var status in searchStatuses) if(status.Value is not null)
        {
            <div class="status-row">
                @switch (status.Value.Status)
                {
                    case ProcessStatus.NotStarted:
                        <MudIcon Class="ma-1" Icon="@Icons.Material.Filled.Pending" />
                        break;
                    case ProcessStatus.InProgress:
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
                        break;
                    case ProcessStatus.Finished:
                        <MudIcon Class="ma-1" Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                        break;
                    case ProcessStatus.Failed:
                        <MudIcon Class="ma-1" Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" />
                        break;
                    default:
                        break;
                }
                @switch (status.Key)
                {
                    case SearchSourceType.PirateBay:
                        <img class="progress-source-img" src="/images/piratebay.svg" />
                        break;
                    case SearchSourceType.Rarbg:
                        <img class="progress-source-img" src="/images/rarbg.png" />
                        break;
                    default:
                        break;
                }
                <MudText>@status.Value.Title</MudText>
                @if (!string.IsNullOrWhiteSpace(status.Value.Message))
                {
                    <MudText Class="ml-1 progress-status-text">@status.Value.Message</MudText>
                }
            </div>
        }
    </div>
</MudPopover>

