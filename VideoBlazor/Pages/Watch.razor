@using VideoBlazor.Core.Model
@using VideoBlazor.Core.Services
@using VideoBlazor.Domain.Interfaces;
@using VideoBlazor.Domain.Models
@using SharedPages
@using VideoBlazor.SegmentFinder;
@inject IMediaItemRepository MediaItemRepository
@inject IDialogService _dialogService

@page "/watch"

@if (IsEverythingEmpty())
{
    <MudText Style="margin: 12px;">No media added yet. Add from "Folders" or search for a torrent.</MudText>
}

@if (recentItems?.Any() ?? false)
{
    <SelectorCarousel Items="recentItems" HeaderTitle="Continue Watching" />
}
@if (newItems?.Any() ?? false)
{
    <SelectorCarousel Items="newItems" HeaderTitle="Not yet watched" />
}
@if (missingItems?.Any() ?? false)
{
    <SelectorCarousel Items="missingItems" HeaderTitle="No longer on disk" ButtonText="Clear all" OnButtonClick="ClearAllMissingItems" />
}

<MudDivider />

@code {
    public IList<MediaItem> recentItems;
    public IList<MediaItem> newItems;
    public IList<MediaItem> missingItems;

    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
    }

    private async Task LoadItems()
    {
        var allItems = (await MediaItemRepository.LoadMediaItems())?.ToList();

        missingItems = allItems?
        .Where(item => !Directory.Exists(item.FolderDirectory))
        .ToList();

        allItems.RemoveAll(item => missingItems.Contains(item));

        recentItems = allItems?
        .Where(x => x.History?.LastOrDefault() != null)
        .OrderBy(x => x.History?.LastOrDefault()?.PlaybackTime ?? DateTime.MaxValue)
        .Reverse()
        .ToList();

        newItems = allItems?
        .Where(x => x.History?.LastOrDefault() == null)
        .ToList();

        StateHasChanged();
    }

    private async Task ClearAllMissingItems()
    {
        var parameters = new DialogParameters();
        parameters.Add("ContentText", $"Do you really want to delete all unused items?");
        parameters.Add("ButtonText", "Delete");
        parameters.Add("Color", Color.Error);

        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = _dialogService.Show<CommonDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            foreach(var item in missingItems)
            {
                await MediaItemRepository.DeleteMediaItem(item.Id);
            }
        }

        await LoadItems();
    }

    private bool IsEverythingEmpty() => 
    !(missingItems?.Any() ?? false) &&
    !(recentItems?.Any() ?? false) &&
    !(newItems?.Any() ?? false);
}