page "/itemDetails/{id}"
@using System.Diagnostics
@using VideoBlazor.Core.Exceptions
@using VideoBlazor.Core.Filenames;
@using VideoBlazor.Core.Model
@using VideoBlazor.Core.Services
@using VideoBlazor.Core.Enums;
@using VideoBlazor.Core.Utils
@inject NavigationManager NavigationManager
@inject MediaItemService MediaItemService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRunTime

<MudButton Variant="Variant.Filled" @onclick="OnBack">
    <i class="fa-solid fa-arrow-left"></i>
    <span>Back</span>
</MudButton>

<MudButton Variant="Variant.Filled" @onclick="OnDelete">
    <i class="fa-solid fa-trash mr-1"></i>
    <span>Delete</span>
</MudButton>

@if(item is null) {
    <h4>No item</h4>
} else {
    
    <h3>@item.Title</h3>
    <div id="item-info-box">
        @if (string.IsNullOrWhiteSpace(item.Image))
        {
			<img id="item-image" src="/images/default-media.png" />
		} else {
            <img id="item-image" src="@item.Image" />
		}
        <span id="item-description">Descripton</span>
    </div>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Files">
        <div class="navigation-container">
            <p class="nav-item" @onclick=" OpenRootFolder">Root</p>
            @foreach(var folder in navigation) {
                <span><i class="fa-solid fa-chevron-right ml-1"></i></span> <!-- Have to wrap in span because of blazor font-awesome bug -->
                    <p class="ml-1 nav-item" @onclick="()=> OpenFolderFromNavigation(folder)">@folder.Title</p>
            }
        </div>

         <MudList Clickable="true">
            <MudDivider />
            @foreach (var file in currentFiles)
            {
                <div class="file-list-item" @onclick="() => ClickFile(file)">
                    <span class="file-title">@file.Title</span>
                    @if (file.EpisodeTags is not null)
                    {
                        @foreach (var tag in file.EpisodeTags)
                        {
                            <MudChip Variant="Variant.Outlined" Color="Color.Primary">@tag</MudChip>
                        }
                    }
                    @if(file.OtherTags is not null)
                    {
                        @foreach (var tag in file.OtherTags)
                        {
                        <MudChip Variant="Variant.Outlined" Color="Color.Secondary">@tag</MudChip>
                        }
                    }
                    @if (file.FormatTags is not null)
                    {
                        @foreach (var tag in file.FormatTags)
                        {
                        <MudChip Variant="Variant.Outlined" Color="Color.Info">@tag</MudChip>
                        }
                    }
                    </div>
               
            }
            @if(currentFiles.Count == 0) {
                <MudText>No files</MudText>
            }
        </MudList>
    </MudTabPanel>
    <MudTabPanel Text="Watch history">
        @if (item.History is null) { 
            <span>No history</span>
        } else {
                <MudDivider />
            for(var i = item.History.Count() - 1; i >= 0; i--) {
                <div class="card history-list-item">
				    <span class="history-list-title">@item.History[i].Title</span>
                        <span class="history-list-date">@item.History[i].PlaybackTime.ToShortDateString() @item.History[i].PlaybackTime.ToShortTimeString()</span>
                        <button class="history-list-button" @onclick="() => OpenFile(item.History[i])">
					    <i class="fa-solid fa-play"></i>
				    </button>
			    </div>
                <MudDivider />
            }
        }
    </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public string Id { get; set; }

    //TODO better alert system
    private bool _alert = true;
    private string _alertText = "";

    public MediaItem item;
    public List<MediaFile> currentFiles = new List<MediaFile>();
    public List<MediaFile> navigation = new List<MediaFile>();

    protected override async Task OnInitializedAsync()
    {
        item = await MediaItemService.LoadMediaItem(Id);
        OpenRootFolder();

        if(item.History is null) {
            item.History = new List<PlaybackHistory>();
        }
    }

    public void OpenFolder(MediaFile folder) {
        LoadFolder(folder);
        navigation.Add(folder);
    }

    public void OpenFolderFromNavigation(MediaFile folder)
    {
        LoadFolder(folder);

        var currentIndex = navigation.FindIndex(n => n.Path == folder.Path);
        if (currentIndex == -1) return;

        for(var i = navigation.Count - 1; i > currentIndex; i--) {
            navigation.RemoveAt(i);
        }
    }

    public async Task OpenFile(PlaybackHistory historyItem)
    {
        await MediaItemService.AddHistoryItem(item.Id, new PlaybackHistory
        {
            Filename = historyItem.Filename,
            Title = historyItem.Title,
            PlaybackTime = DateTime.Now
        });
        await LaunchFile(historyItem.Filename);
        item = await MediaItemService.LoadMediaItem(Id);
    }

    public async Task ClickFile(MediaFile file)
    {
        if (file.Type == FileType.File)
            await OpenFile(file);
        else if (file.Type == FileType.Folder)
            OpenFolder(file);
    }

    private async Task OpenFile(MediaFile file)
    {
        await MediaItemService.AddHistoryItem(item.Id, new PlaybackHistory
        {
            Filename = file.Path,
            Title = file.Title,
            PlaybackTime = DateTime.Now
        });
        LaunchFile(file.Path);
        item = await MediaItemService.LoadMediaItem(Id);
    }

    private async Task LaunchFile(string path) {
        if(!File.Exists(path))
        {
            Snackbar.Add($"File \"{Path.GetFileName(path)}\" not found", Severity.Error);
            return;
        }
        FileService.LaunchMediaFile(path);
    }

    private async Task LoadFolder(MediaFile folder)
    {
        currentFiles = MediaItemService.GetFilesForDirectory(folder.Path, item.Files);
        await RecalculateTags();
    }

    public async Task OpenRootFolder() {
        currentFiles = MediaItemService.GetFilesForDirectory(item.FolderDirectory, item.Files);
        navigation = new List<MediaFile>();
        await RecalculateTags();
    }

    private async Task RecalculateTags()
    {
        var files = currentFiles.Where(f => f.Type == FileType.File && f.FormatTags is null);

        foreach (var file in files)
        {
            var parsed = await ParseFilename(file.Path);

            file.EpisodeTags = new List<string>();
            if (parsed.Seasons is not null)
            {
                file.EpisodeTags.Add($"Season {parsed.Seasons.FirstOrDefault()}");
            }
            if (parsed.Episodes is not null)
            {
                file.EpisodeTags.Add($"Episode {parsed.Episodes.FirstOrDefault()}"); 
            }

            file.FormatTags = new List<string>();
            if (!string.IsNullOrWhiteSpace(parsed.Resolution))
            {
                file.FormatTags.Add(parsed.Resolution);
            }
            if(!string.IsNullOrWhiteSpace(parsed.VideoCodec))
            {
                file.FormatTags.Add(parsed.VideoCodec);
            }
            file.FormatTags.Add(Path.GetExtension(file.Path));
        }
        StateHasChanged();
    }

    public void OnBack() {
        NavigationManager.NavigateTo("/");
    }

    public async void OnDelete()
    {
        await MediaItemService.DeleteMediaItem(new Guid(Id));
        OnBack();
    }

    private string GetFileIcon(FileType type)
    {
        return type switch
        {
            FileType.File => Icons.Material.Filled.Slideshow,
            FileType.Folder => Icons.Material.Filled.Folder,
            _ => ""
        };
    }

    private async Task<ParsedFilenameModel> ParseFilename(string path)
    {
        try
        {
            return await JsRunTime.InvokeAsync<ParsedFilenameModel>("FilenameParser.ParseFilename", new object[2] { Path.GetFileName(path), true });
        }
        catch (Exception)
        {
            //TODO log
        }
        //Dirty fallback
        try
        {
            return await JsRunTime.InvokeAsync<ParsedFilenameModel>("FilenameParser.ParseFilename", new object[2] { Path.GetFileName(path), false });
        } catch(Exception)
        {
            //TODO log
        }
        return null;
    }

}
