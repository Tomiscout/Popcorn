@inherits LayoutComponentBase
@inject NavigationManager NavManager

<MudThemeProvider IsDarkMode="true" Theme="MyCustomTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
	<MudPaper Style="height: 100%;background-color: #27272e;border-right: 1px solid #585858;border-radius: 0;" Class="py-3" Width="150px" Elevation="0">
    	<NavMenu/>
    </MudPaper>

	<main>
		@Body
	</main>
</div>

@code{
	MudTheme MyCustomTheme = new MudTheme()
	{
		Palette = new Palette()
		{
			Primary = "#c14055",
			Secondary = "#40C1AC",
			AppbarBackground = Colors.Red.Default,
		},
		PaletteDark = new PaletteDark()
		{
			Primary = "#c14055",
			Secondary = "#40C1AC",
		},

		LayoutProperties = new LayoutProperties()
		{
			DrawerWidthLeft = "260px",
			DrawerWidthRight = "300px"
		}
	};

	protected override void OnInitialized()
	{
		NavManager.NavigateTo("/watch");
	}
}