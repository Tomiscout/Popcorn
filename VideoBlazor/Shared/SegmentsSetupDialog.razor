@using VideoBlazor.Domain.Enum;
@using VideoBlazor.Domain.Interfaces;
@using VideoBlazor.Domain.Models;
@using VideoBlazor.Domain.Services;
@using VideoBlazor.SegmentFinder;
@using VideoPlayer.Domain.Extensions;
@inject SegmentFinderService _segmentFinderService;
@inject MediaItemRefreshService RefreshService;
@inject IMediaItemRepository _mediaItemRepository
@inject MediaItemRefreshService _mediaItemRefreshService

<MudDialog>
    <DialogContent>
        
        <MudTable Style="width: 100%;" Items="@item.Segments" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Loading="false" LoadingProgressColor="Color.Info">
            <HeaderContent>
                <MudTh>Type</MudTh>
                <MudTh>Length</MudTh>
                <MudTh>Track</MudTh>
                <MudTh>Remove</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Type">@context.Type.ToString()</MudTd>
                <MudTd DataLabel="Length">@context.Length.ToString("#.0") seconds</MudTd>
                <MudTd DataLabel="Track">
                    @if (AudioData.ContainsKey(context.Id))
                    {
                        <audio controls>
                            <source src="@($"data:audio/wav;base64,{AudioData[context.Id]}")" type="audio/wav" />
                            Your browser does not support the audio element.
                        </audio>
                    }
                    else
                    {
                        <MudProgressCircular Color="Color.Default" Indeterminate="true" />
                    }
                    @{/*else
                    {
                        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PlayArrow" IconColor="Color.Secondary" Size="Size.Small" OnClick="() => LoadAudio(context.Id)">Play</MudButton>
                    }*/}
                </MudTd>
                <MudTd DataLabel="Remove">
                    <MudButton StartIcon="@Icons.Material.Filled.RemoveCircle" OnClick="() => RemoveSegment(context.Id)"></MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="AutoDetect">Detect intro/outro segments</MudButton>
        <MudButton OnClick="ScanLibrary" Disabled="@(!item.Segments.Any())" >Apply segments in library</MudButton>
        <MudButton OnClick="ClearSegments" Disabled="@AppliedSegmentsExist()">Reset applied segments</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public MediaItem item { get; set; }

    private Dictionary<Guid, string> AudioData = new();

    public class SegmentView
    {
        public int Index { get; set; }
        public string AudioPath { get; set; }
    }

    /*
    * Idea is walking file tree, searching for intros/outros. there may be multiple of results.
    * First - autodetect intro, add to bank, show to user.
    * Keep searching for intros, if failed - autodetect other intros from remaining files and add to intro bank
    * Do same with outros, but separately.
    * Intros and outros may vary, there also short intros so will need to add support that in the future.
    *
    * A way to optimize would be check if intro is in begining and only export the same time, if failed - export 6 minutes
    * Assume outros will be always in the end, if not - make bigger export
    */

    //Utilize next track algorithm to iterate files

    //After auto detect - show user segments, if multiple, to choose the correct one

    protected override async Task OnInitializedAsync()
    {
        RefreshService.OnRefreshRequested += RefreshLoadMediaItem;
        LoadAudio();
    }

    public void Dispose()
    {
        RefreshService.OnRefreshRequested -= RefreshLoadMediaItem;
    }

    private async Task RefreshLoadMediaItem(Guid itemId)
    {
        if (itemId != item.Id) return;

        await InvokeAsync(async () =>
        {
            item = await _mediaItemRepository.LoadMediaItem(itemId);
            StateHasChanged();

            LoadAudio();
        });
    }

    public async Task AutoDetect()
    {
        Task.Run(async () =>
        {
            await _segmentFinderService.AutoDetect(item);
        });
    }

    public async Task ScanLibrary()
    {
        item = await _mediaItemRepository.LoadMediaItem(item.Id);
        Task.Run(async () =>
        {
            await _segmentFinderService.ScanLibrary(item);
        });
    }

    private bool AppliedSegmentsExist()
    {
        return item.Files.Any(f => f.IntroProcessed || f.OutroProcessed);
    }

    private async Task ClearSegments()
    {
        await _mediaItemRepository.ClearSegmentInfo(item.Id);
        _mediaItemRefreshService.RequestRefresh(item.Id);
    }

    private async Task RemoveSegment(Guid segmentId)
    {
        await _mediaItemRepository.RemoveSegmentInfo(item.Id, segmentId);
        _mediaItemRefreshService.RequestRefresh(item.Id);
    }

    private void LoadAudio()
    {
        if (item.Segments is null) return;

        foreach(var segment in item.Segments)
        {
            if(!AudioData.ContainsKey(segment.Id))
            {
                LoadAudioSegment(segment.Id);
            }
        }
    }

    private void LoadAudioSegment(Guid segmentId)
    {
        var segment = item.Segments.First(i => i.Id == segmentId);
        AudioData[segmentId] = ConvertToBase64(segment.FilePath);
        StateHasChanged();
    }

    private string ConvertToBase64(string path)
    {
        var bytes = File.ReadAllBytes(path);
        return Convert.ToBase64String(bytes);
    }
}