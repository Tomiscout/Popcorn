@page "/folders"
@using Blazored.Modal.Services
@using Popcorn.Core
@using Popcorn.Core.Services
@using Popcorn.Core.Model
@using Popcorn.Domain.Interfaces;
@using Popcorn.Domain.Models;
@using Popcorn.Domain;
@inject FolderService FolderService
@inject IMediaItemRepository MediaItemRepository
@inject IDialogService _dialogService


<div class="pa-4">
	<h2>Scan folders</h2>
    @if (folders == null)
    {
    	<p><em>Loading...</em></p>
    }
    else if(folders.Count == 0)
    {
    	<p>No folders</p>
    }
    else {
    	<div class="list-group list-group-flush">
    		@foreach (var folder in folders)
    		{
    			<div class="card folder-list-item">
    				<span class="folder-path">@folder.Path</span>
    				<MudButton class="folder-list-button" Variant="Variant.Filled" @onclick="() => DeleteFolder(folder)">
    					<i class="fa-solid fa-trash mr-1"></i>
    					<span>Delete</span>
    				</MudButton>
    			</div>
    		}
    	</div>
    }
    
    <div class="mt-2"></div>
    
    <MudButton Variant="Variant.Filled" @onclick="AddNewFolder">
    	<span>Add folder</span>
    </MudButton>
    
    <div class="mb-3"></div>
    <h2>Media</h2>
    @if (folders == null) //TODOO fix
    {
    	<p><em>Loading...</em></p>
    }
    else if (folders.Count == 0)
    {
    	<p>No results</p>
    }
    else
    {
    	<MudButton class="folder-list-button" Variant="Variant.Filled" @onclick="ScanFolders">
    		<span><i class="fa-solid fa-arrows-rotate"></i></span>
    		<span>Refresh</span>
    	</MudButton>
    	<MudList Clickable="true">
            <MudExpansionPanels MultiExpansion="true">
                
    		@foreach (var entry in groupedScanResults)
    		{
                    <MudExpansionPanel Text="@entry.Key" TitleContent="@CreateTitleContent(entry.Key, entry.Value.Count)"
                                       IsInitiallyExpanded="entry.Value.Count > 0" Disabled="@(entry.Value.Count == 0)">

                        @foreach (var scanResult in entry.Value)
                        {
                            <div class="folder-list-item">
                                <span class="folder-path">@scanResult.Title</span>
                                <span class="file-count-label">@scanResult.Files.Count file@(scanResult.Files.Count != 1 ? "s" : "")</span>
                                <button class="folder-list-button" @onclick="() => AddScanResult(scanResult)">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                            <MudDivider />
                        }
                        @if (entry.Value.Count == 0)
                        {
                            <MudText>No files in folder</MudText>
                        }
                </MudExpansionPanel>
    		}
            </MudExpansionPanels>
    	</MudList>
    }
</div>

@code {
    private IList<Folder> folders;
    private Dictionary<string, IList<MediaScanResult>> groupedScanResults;

    public RenderFragment CreateTitleContent(string title, int count) => builder =>
       {
           builder.OpenElement(0, "div");
           builder.AddAttribute(1, "style", "display: flex; justify-content: space-between;");

           builder.OpenElement(2, "span");
           builder.AddContent(3, title);
           builder.CloseElement();

           builder.OpenElement(4, "span");
           builder.AddContent(5, $"Count: {count}");
           builder.CloseElement();

           builder.CloseElement();
       };



    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(100);
        folders = await FolderService.LoadSavedFolders();
        ScanFolders();
    }

    public async Task AddNewFolder() {
        var result = await FolderService.OpenFolderPicker();
        if (result == null) return;

        folders.Add(new Folder {
			Path = result
		});
        await FolderService.SaveFolders(folders);
    }

    public async Task DeleteFolder(Folder folder) {
        await FolderService.DeleteFolder(folder.Path);
        folders = await FolderService.LoadSavedFolders();
    }

    public async Task ScanFolders() {
        groupedScanResults = new Dictionary<string, IList<MediaScanResult>>();
        var currentFolders = await MediaItemRepository.GetMediaItemFolders();

        foreach(var folder in folders) {
            groupedScanResults.Add(folder.Path, await MediaLoader.ScanFolder(folder.Path, currentFolders));
        }


        StateHasChanged();
    }

	public async Task AddScanResult(MediaScanResult result) {
        var parameters = new DialogParameters();
        parameters.Add("inputData", result);

        var options = new DialogOptions { CloseOnEscapeKey = true };
        _dialogService.Show<CreateMediaItemModal>("Save media for watching", parameters, options);
	}
}
