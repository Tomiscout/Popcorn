<maui:MauiWinUIApplication
    x:Class="Popcorn.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:Popcorn.WinUI">

    <maui:MauiWinUIApplication.Resources>
        <DataTemplate x:Key="MauiAppTitleBarTemplate">
            <Border
            Canvas.ZIndex="1" 
            VerticalAlignment="Stretch"
            Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="12, 0, 0, 0" x:Name="RootStackPanel">
                    <Image 
                    x:Name="AppFontIcon"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center"
                    Source="appiconLogo.scale-100.png"
                    Visibility="Visible"
                    Width="16" 
                    Height="16"/>
                    <TextBlock 
                    x:Name="Title"
                    VerticalAlignment="Center"
                    Margin="{Binding WindowTitleMargin}"
                    Text="{Binding WindowTitle}"
                    Foreground="{Binding WindowTitleForeground}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </maui:MauiWinUIApplication.Resources>
</maui:MauiWinUIApplication>
