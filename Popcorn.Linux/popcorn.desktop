[Desktop Entry]
Type=Application
Name=Popcorn
Comment=Media library and video player
Exec=@INSTALL_DIR@/Popcorn.Linux
Path=@INSTALL_DIR@
Icon=@INSTALL_DIR@/popcorn.png
Terminal=false
StartupNotify=true
Categories=AudioVideo;Video;Player;
StartupWMClass=popcorn
Actions=uninstall;

[Desktop Action uninstall]
Name=Uninstall Popcorn
Exec=@INSTALL_DIR@/Popcorn.Installer.Linux --uninstall
