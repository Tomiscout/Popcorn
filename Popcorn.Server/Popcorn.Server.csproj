<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Popcorn.Server</RootNamespace>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
        <!-- No IIS web.config in the published output -->
        <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
        <!-- File description + company: the name and publisher Task Manager → Startup apps shows for the autostart. -->
        <AssemblyTitle>Popcorn</AssemblyTitle>
        <Company>Popcorn</Company>
        <Product>Popcorn</Product>
        <!-- Doc comments of the socket contract go into the generated TypeScript (Contracts/SocketContractWriter.cs). -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

    <!-- Windows release builds run in the background (tray, no console window); Debug keeps the console. -->
    <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(Configuration)' == 'Release'">
        <OutputType>WinExe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FFMpegCore" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.File" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Popcorn.Core\Popcorn.Core.csproj" />
        <ProjectReference Include="..\Popcorn.Platform\Popcorn.Platform.csproj" />
        <ProjectReference Include="..\Popcorn.Downloads\Popcorn.Downloads.csproj" />
        <ProjectReference Include="..\Popcorn.Plugins.Abstractions\Popcorn.Plugins.Abstractions.csproj" />
        <ProjectReference Include="..\Popcorn.SegmentFinder\Popcorn.SegmentFinder.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Bundled plugins (gitignored runtime folder): copied as-is, never compiled/published as content -->
        <Content Remove="plugins\**" />
        <None Remove="plugins\**" />
        <Compile Remove="plugins\**" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="systemd\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <!-- The web UI (Popcorn.Web/dist, `npm run build` there) as web/, and whatever is in plugins/: added as content in a
         target (globbed when building, not when the project is loaded), so both the build output and `dotnet publish`
         get them. -->
    <Target Name="IncludeWebAndPlugins" BeforeTargets="BeforeBuild">
        <!-- Replace, not merge: file names are content-hashed, old bundles would pile up. -->
        <RemoveDir Directories="$(OutDir)web;$(OutDir)plugins" />
        <ItemGroup>
            <WebFile Include="..\Popcorn.Web\dist\**\*.*" />
            <PluginFile Include="plugins\**\*.*" />
            <Content Include="@(WebFile)" Link="web\%(WebFile.RecursiveDir)%(WebFile.Filename)%(WebFile.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
            <Content Include="@(PluginFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>
    <!-- The web UI's socket contract (Popcorn.Web/src/socket/socket-requests.ts + socket-payloads.ts) from the
         [WebSocketEvent] handlers; only rewritten when it changes. Not when cross-building for another OS's RID. -->
    <Target Name="WriteSocketContracts" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' And '$(SkipSocketContracts)' != 'true'">
        <Exec Command="dotnet &quot;$(TargetPath)&quot; --write-socket-contracts &quot;$(MSBuildProjectDirectory)/../Popcorn.Web/src/socket&quot;" />
    </Target>
</Project>
