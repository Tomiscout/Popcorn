<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Popcorn.Server</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.12" />
        <PackageReference Include="Serilog" Version="4.3.0" />
        <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Popcorn.Application\Popcorn.Application.csproj" />
        <ProjectReference Include="..\Popcorn.Domain\Popcorn.Domain.csproj" />
        <ProjectReference Include="..\Popcorn.Persistence\Popcorn.Persistence.csproj" />
        <ProjectReference Include="..\Popcorn.PlayerServer\Popcorn.PlayerServer.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="web\" />
    </ItemGroup>
    <Target Name="CopyWebToOutput" AfterTargets="Build">
        <ItemGroup>
            <FilesToCopy Include="web\**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(OutputPath)web\%(RecursiveDir)" />
    </Target>
</Project>