@page "/folders"
@using Blazored.Modal.Services
@using VideoBlazor.Core
@using VideoBlazor.Core.Services
@using VideoBlazor.Core.Model
@inject FolderService FolderService
@inject IModalService modal

<h2>Scan folders</h2>
@if (folders == null)
{
	<p><em>Loading...</em></p>
}
else if(folders.Count == 0)
{
	<p>No folders</p>
}
else {
	<div class="list-group list-group-flush">
		@foreach (var folder in folders)
		{
			<div class="card folder-list-item">
				<span class="folder-path">@folder.Path</span>
				<button class="folder-list-button" @onclick="() => DeleteFolder(folder)">
					<i class="fa-solid fa-trash"></i>
				</button>
			</div>
		}
	</div>
}

<div class="mt-2"></div>
<button type="button" class="btn btn-primary" @onclick="AddNewFolder">Add folder</button>
<button type="button" class="btn btn-primary" @onclick="OpenRootFolder">Open root folder</button>

<div class="mb-3"></div>
<h2>Media</h2>
@if (folders == null) //TODOO fix
{
	<p><em>Loading...</em></p>
}
else if (folders.Count == 0)
{
	<p>No results</p>
}
else
{
	<button type="button" class="btn btn-primary" @onclick="ScanFolders">
		<i class="fa-solid fa-arrows-rotate"></i>
	</button>
	<div class="list-group list-group-flush">
		@foreach (var entry in groupedScanResults)
		{
			<div>
				<h3>@entry.Key</h3>
				@foreach (var scanResult in entry.Value)
				{
					<div class="card folder-list-item">
						<span class="folder-path">@scanResult.Title</span>
						<span class="file-count-label">@scanResult.Files.Count file@(scanResult.Files.Count != 1 ? "s" : "")</span>
						<button class="folder-list-button" @onclick="() => AddScanResult(scanResult)">
							<i class="fa-solid fa-plus"></i>
						</button>
					</div>
				}
			</div>
		}
	</div>
}


