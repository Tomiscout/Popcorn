@using VideoBlazor.Core.Model
@using VideoBlazor.Core.Services;
@using VideoBlazor.Core;
@using VideoBlazor.Platforms.Windows

@inject MediaItemService MediaItemService
@inject IFolderPicker _folderPicker

@page "/createMediaItem"


<div>
	<EditForm Model="@createItem" OnValidSubmit="@HandleValidSubmit">
		<DataAnnotationsValidator />
		<ValidationSummary />

		<div class="form-floating mb-3">
			<InputText type="text" class="form-control"@bind-Value="createItem.Title" />
			<label for="floatingInput">Media title</label>
		</div>

		<div id="image-box">
			@if(createItem.Image is null) {
				<span>No image loaded</span>
				<br />
				<button type="button" class="btn btn-secondary" @onclick="PickImageFromFile">Select image</button>
			} else {
				<img src="@createItem.Image" style="width:100%; height:100%;" />
			}
		</div>


		<button type="submit" class="btn btn-primary">Submit</button>
	</EditForm>
</div>



@code {
	[CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;

	[Parameter] public MediaScanResult? inputData { get; set; }

	public MediaItem createItem { get; set; } = new MediaItem();

	private async Task Close() => await BlazoredModal.CloseAsync();

	protected override async Task OnInitializedAsync()
	{
		if(inputData is not null) {
			createItem.Title = inputData.Title;
			createItem.FolderDirectory = inputData.FolderPath;
			createItem.Files = inputData.Files;
		}
	}

	public async Task HandleValidSubmit() {
		await MediaItemService.AddMediaItem(createItem);
		await Close();
	}

	public async Task PickImageFromFile() {
		var filePath = await _folderPicker.PickImageFile();
		if(filePath is not null) {
			createItem.ImagePath = filePath;
			createItem.Image = await ImageUtils.LoadImage(filePath, false);
		}
	}
}