@using Popcorn.Domain.Models
@using Popcorn.Persistence
@inject NavigationManager NavigationManager
@inject ImageRepository _imageRepository
@namespace Popcorn.WebView.Shared

<div class="watch-card">
    @if(showOptions)
    {
        <div class="options-panel">
            <span>hello</span>
            <!-- Options content goes here -->
        </div>
    }
    <div class="image-container" @onclick="() => OnItemClick(Item)">
        @if (string.IsNullOrWhiteSpace(ItemImageData))
        {
            <img class="rounded-image" src="/images/default-media.jpg" />
        }
        else
        {
            <img src="@ItemImageData" class="rounded-image" alt="@Item.Title" />
        }
        <span class="display-title">@Item.GetDisplayTitle()</span>
    </div>
</div>


@code {
    [Parameter]
    public MediaItem Item { get; set; }

    public string ItemImageData { get; set; } = string.Empty;

    public bool showOptions { get; set; } = false;

    public void OnItemClick(MediaItem item)
    {
        NavigationManager.NavigateTo($"/itemDetails/{item.Id}");
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Item.ImagePath))
        {
            ItemImageData = await _imageRepository.LoadImage(Item.ImagePath);
        }
    }
}