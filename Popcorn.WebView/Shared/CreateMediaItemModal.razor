@using Popcorn.Core.Model
@using Popcorn.Core.Services;
@using Popcorn.Core;
@using Popcorn.Core.Enums;
@using Popcorn.Domain.Interfaces
@using Popcorn.Persistence;
@using Popcorn.Domain.Models;
@using MudBlazor

@inject MediaItemService MediaItemService
@inject INativeFolderService _nativeFolderService
@inject ImageRepository _imageRepository
@namespace Popcorn.WebView.Shared

@page "/createMediaItem"

<MudDialog Style="width: 600px;">
    <DialogContent>
        <MudForm Model="@createItem">
            <MudTextField @bind-Value="createItem.Title" Label="Media title" Variant="Variant.Text" />

            <MudItem Style="display: flex; flex-direction:row;width:100%;">
                @if (string.IsNullOrWhiteSpace(createItem.ImagePath))
                {
                    <MudImage Src="/images/default-media.png" Style="padding: 8px;width:300px; height:300px;" />
                }
                else
                {
                    <MudImage Src="@ImageData" Style="padding: 8px;width:300px; height:300px;" />
                }
                <div style="
                        display: flex;
                        flex-grow: 1;
                        padding: 8px;
                        align-items: flex-end;
                        justify-content: flex-end;">
                    <MudButton Style="margin:0 8px;" Color="Color.Secondary" Variant="Variant.Filled" OnClick="PickImageFromFile">Select image</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(async () => await HandleValidSubmit())">Submit</MudButton>
                </div>
            </MudItem>
        </MudForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public MediaScanResult? inputData { get; set; }

    public MediaItem createItem { get; set; } = new MediaItem();

    public string ImageData { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (inputData is not null)
        {
            createItem.Title = inputData.Title;
            createItem.FolderDirectory = inputData.FolderPath;
            createItem.Files = new List<MediaFile>();
        }
    }

    public async Task HandleValidSubmit()
    {
        if (string.IsNullOrWhiteSpace(createItem.Title)) return; //TODO proper form validation using mud form stuff

        await MediaItemService.CreateMediaItemFromScan(createItem, inputData);
    }

    public async Task PickImageFromFile()
    {
        var filePath = await _nativeFolderService.PickImageFile();
        if (filePath is not null)
        {
            createItem.ImagePath = filePath;
            ImageData = await _imageRepository.LoadImage(filePath, false);
        }
    }
}