@using System.Text.Json;
@using Popcorn.Core.Model
@using Popcorn.Core.Services
@using MonoTorrent.Client
@using System.Timers;
@using Popcorn.Domain.Models;
@using Popcorn.Shared.Utils;
@using Popcorn.Torrent.Model
@using Popcorn.Torrents
@inject TorrentCore _torrentCore
@inject IDialogService dialog

@page "/torrents"

<style>
    .selected {
        background-color: #1E88E5 !important;
    }

        .selected > td {
            color: white !important;
        }

            .selected > td .mud-input {
                color: white !important;
            }
</style>

<div id="main">
    <div id="controls">
        <button class="header-button" @onclick="StartSelected">
            <i class="fa-solid fa-play fa-2xl"></i>
        </button>
        <button class="header-button" @onclick="PauseSelected">
            <i class="fa-solid fa-pause fa-2xl"></i>
        </button>
        <button class="header-button" @onclick="DeleteSelected">
            <i class="fas fa-trash fa-2xl"></i>
        </button>
        <button class="header-button" @onclick="OpenSettings">
            <i class="fas fa-cog fa-2xl"></i>
        </button>
    </div>
    <div id="content">
        @if(!torrents.Any())
        {
            <MudProgressCircular></MudProgressCircular>
        }
        <MudTable @ref="_table" Items="@torrents" T="TorrentViewModel"
                  Hover="true"
                  @bind-SelectedItems="selectedItems"
                  OnRowClick="@OnRowClick"
                  Dense="true"
                  MultiSelection="true">
            <HeaderContent>
                <MudTh><MudTableSortLabel Style="width:500px;" SortBy="new Func<TorrentViewModel, object>(x => x.Title)">Title</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel Style="max-width:40px" SortBy="new Func<TorrentViewModel, object>(x => x.Size)">Size</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel Style="max-width:40px" SortBy="new Func<TorrentViewModel, object>(x => x.Status)">Status</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel Style="width:100px" SortBy="new Func<TorrentViewModel, object>(x => x.Progress)">Progress</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel Style="max-width:40px" SortBy="new Func<TorrentViewModel, object>(x => x.ETA)">ETA</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel Style="max-width:40px" SortBy="new Func<TorrentViewModel, object>(x => x.DownloadSpeed)">Download speed</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel Style="max-width:40px" SortBy="new Func<TorrentViewModel, object>(x => x.UploadSpeed)">Upload speed</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel Style="max-width:40px" SortBy="new Func<TorrentViewModel, object>(x => x.Seeds)">Seeds</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel Style="max-width:40px" SortBy="new Func<TorrentViewModel, object>(x => x.Seeds)">Peers</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="max-width: 500px;" DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Size">@context.Size</MudTd>
                <MudTd DataLabel="Status">@context.Status</MudTd>
                <MudTd DataLabel="Progress">
                    <div class="progress-container">
                        <span>@context.Progress %</span>
                        <MudProgressLinear Style="height: 16px;" Class="progress-bar" Color="Color.Tertiary" Size="Size.Large" Value="@context.Progress"/>
                    </div>
                </MudTd>
                <MudTd DataLabel="ETA">@context.ETA</MudTd>
                <MudTd DataLabel="DownloadSpeed">@context.DownloadSpeed</MudTd>
                <MudTd DataLabel="UploadSpeed">@context.UploadSpeed</MudTd>
                <MudTd DataLabel="Seeds">@context.Seeds</MudTd>
                <MudTd DataLabel="Peers">@context.Peers</MudTd>
            </RowTemplate>
        </MudTable>
    </div>
    <div id="details" style="height:217px;">
        @if (_details != null)
        {
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                <MudTabPanel Text="General">
                    <MudText><b>Size:</b> @_details.Size</MudText>
                    <MudText><b>Downloaded:</b> @_details.Downloaded</MudText>
                    <MudText><b>Uploaded:</b> @_details.Uploaded</MudText>
                    <MudText><b>Save path:</b> @_details.SavePath</MudText>
                    <MudText><b>Progress:</b> @_details.Progress</MudText>
                </MudTabPanel>
                <MudTabPanel Text="Files">

                </MudTabPanel>
            </MudTabs>
        }
    </div>
</div>



