    private async Task StartSelected()
    {
        await _torrentCore.StartTorrents(selectedItems.Select(s => s.Id).ToList());
    }

    private async Task PauseSelected()
    {
        await _torrentCore.StopTorrents(selectedItems.Select(s => s.Id).ToList());
    }

    public async Task DeleteSelected()
    {
        await _torrentCore.RemoveTorrents(selectedItems.Select(s => s.Id).ToList(), true); //TODO wire up delete files bool
    }

    public void OpenSettings()
    {

    }

    private string SelectedRowClassFunc(TorrentViewModel element, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (_table.SelectedItem != null && _table.SelectedItem.Equals(element))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    public void OnRowClick(TableRowClickEventArgs<TorrentViewModel> args)
    {
        if(args.Row.IsChecked)
        {
            RecalculateItemDetails(args.Item);
        }
    }

    private TorrentManager GetManager(TorrentViewModel model)
    {
        return _torrentCore.GetManager(model.Id);
    }

    private void RecalculateItemDetails(TorrentViewModel viewModel)
    {
        var manager = GetManager(viewModel);

        _details = new TorrentDetails
        {
            Size = StringUtils.FormatBytes(manager.Size),
            Downloaded = "",
            Uploaded = "",
            SavePath = manager.SavePath,
        };
    }

    private void PollInformation(object? sender, ElapsedEventArgs e)
    {
        var updated = _torrentCore.GetTorrentsDisplay();
        foreach (var newModel in updated)
        {
            if(!torrents.Any())
            {
                torrents.Add(newModel);
                continue;
            }
            foreach (var current in torrents)
            {
                if (current.Id != newModel.Id) continue;
                current.Progress = newModel.Progress;
                current.DownloadSpeed = newModel.DownloadSpeed;
                current.UploadSpeed = newModel.UploadSpeed;
                current.Status = newModel.Status;
                current.Peers = newModel.Peers;
                current.Seeds = newModel.Seeds;
            }
        }
        //Application.Current?.MainPage?.Dispatcher.Dispatch(() => StateHasChanged()); update page?
    }

    public class TorrentDetails
    {
        public string Size { get; set; }
        public string Downloaded { get; set; }
        public string Uploaded { get; set; }
        public string SavePath { get; set; }
        public string Progress { get; set; }
    }
}