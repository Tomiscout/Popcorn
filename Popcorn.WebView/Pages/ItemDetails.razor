@page "/itemDetails/{id}"
@using System.Diagnostics
@using Popcorn.Core.Exceptions
@using Popcorn.Core.Filenames;
@using Popcorn.Core.Model
@using Popcorn.Core.Services
@using Popcorn.Core.Enums;
@using Popcorn.Core.Utils
@using Popcorn.Core;
@using Popcorn.Domain
@using Popcorn.Domain.Enum;
@using Popcorn.Domain.Interfaces;
@using Popcorn.Domain.Services;
@using Popcorn.WebView.Services.FileServer
@using Popcorn.WebView.Shared
@using PopcornPlayer.Domain.Extensions;
@using Popcorn.Domain.Models;
@using Popcorn.Persistence;
@using Popcorn.Persistence.Repositories
@using Popcorn.PlayerServer;
@using Popcorn.WebView.Core.Exceptions
@inject MediaItemRefreshService RefreshService;
@inject NavigationManager NavigationManager
@inject MediaItemService MediaItemService
@inject IMediaItemRepository MediaItemRepository
@inject FolderService FolderService
@inject INativeFolderService _nativeFolderService
@inject ImageRepository _imageRepository
@inject SettingsRepository SettingsRepository
@inject IPlayerService PlayerService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRunTime
@inject IDialogService _dialogService
@inject IFileService _fileService

<div class="ma-3">
    <MudButton Variant="Variant.Filled" @onclick="OnBack">
    <i class="fa-solid fa-arrow-left"></i>
        <span class="ml-1">Back</span>
    </MudButton>

    <MudButton Variant="Variant.Filled" @onclick="OnDelete">
        <i class="fa-solid fa-trash mr-1"></i>
        <span class="ml-1">Delete</span>
    </MudButton>

    <MudButton Variant="Variant.Filled" @onclick="OpenFolderExplorer">
        <i class="fa-solid fa-folder-open"></i>
        <span class="ml-1">Open folder</span>
    </MudButton>

    <MudButton Variant="Variant.Filled" @onclick="RescanFolder">
        <i class="fa-solid fa-arrows-rotate"></i>
        <span class="ml-1">Rescan folder</span>
    </MudButton>
</div>

@if(item is null) {
    <h4>No item</h4>
} else {
    
    <div id="item-info-box">
        @if (string.IsNullOrWhiteSpace(item.Image))
        {
			<img id="item-image" src="/images/default-media.jpg" />
		} else {
            <img id="item-image" src="@item.Image" />
		}
        <div style="flex: 1; flex-direction: column;">
            <h3>@item.Title</h3>
            <span id="item-description">Descripton</span>
            <div>
                @if(nextTrack is not null)
                {
                    <MudButton Variant="Variant.Filled" @onclick="OnPlayNext">

                        <i class="fa-solid fa-play"></i>
                        <span class="ml-1">Play next: @nextTrack.Title</span>
                    </MudButton>
                }
                @if (item.Files.Count() > 1)
                {
                    <MudButton Variant="Variant.Filled" @onclick="OpenAutoplaySetup">
                        <i class="fa-solid fa-play"></i>
                        <span class="ml-1">Setup Intro Skipping</span>
                    </MudButton>
                }
            </div>
        </div>
    </div>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Files" @onclick="LoadMediaItem">
        <div class="navigation-container">
                <p class="nav-item" @onclick=" OpenRootFolder">Root</p>
            @foreach(var folder in navigation) {
                <span><i class="fa-solid fa-chevron-right ml-1"></i></span> <!-- Have to wrap in span because of blazor font-awesome bug -->
                    <p class="ml-1 nav-item" @onclick="()=> OpenFolderFromNavigation(folder)">@folder.Title</p>
            }
        </div>

         <MudList Clickable="true">
            <MudDivider />
            @foreach (var file in currentFiles)
            {
                <div class="file-list-item" @onclick="() => ClickFile(file)">
                    @if(file.Type == FileType.Folder)
                    {
                            <MudIcon Class="ma-1" Icon="@Icons.Material.Filled.Folder" />
                    } else
                    {
                            <span class="ma-1"><i class="fa-solid fa-film fa-lg"></i></span>
                    }
                    <span class="file-title @ItemWatchedStyle(file)">@file.GetDisplayTitle()</span>

                    @if (file.IntroProcessed)
                    {
                        <MudChip Variant="Variant.Outlined" Color="Color.Secondary">@(file.SegmentLocations.Any(s => s.StartSeconds >= 0) ? "" : "No ")Intro</MudChip>
                    }
                    @if (file.OutroProcessed)
                    {
                        <MudChip Variant="Variant.Outlined" Color="Color.Secondary">@(file.SegmentLocations.Any(s => s.StartSeconds >= 0) ? "" : "No ")Outro</MudChip>
                    }
                    @if (file.EpisodeTags is not null)
                    {
                        @foreach (var tag in file.EpisodeTags)
                        {
                            <MudChip Variant="Variant.Outlined" Color="Color.Primary">@tag</MudChip>
                        }
                    }
                    @if(file.OtherTags is not null)
                    {
                        @foreach (var tag in file.OtherTags)
                        {
                        <MudChip Variant="Variant.Outlined" Color="Color.Secondary">@tag</MudChip>
                        }
                    }
                    @if (file.FormatTags is not null)
                    {
                        @foreach (var tag in file.FormatTags)
                        {
                        <MudChip Variant="Variant.Outlined" Color="Color.Info">@tag</MudChip>
                        }
                    }
                    </div>
               
            }
            @if(currentFiles.Count == 0) {
                <MudText>No files</MudText>
            }
        </MudList>
    </MudTabPanel>
    <MudTabPanel Text="Watch history" @onclick="LoadMediaItem">
        @if (item.History is null) { 
            <span>No history</span>
        } else {
                <MudDivider />
                for (var i = playbackHistory.Count() - 1; i >= 0; i--)
                {
                    var index = i;
                    <div class="card history-list-item">
                            <span class="history-list-title">@playbackHistory[i].Title</span>
                            <span class="history-list-date">@playbackHistory[i].PlaybackTime.ToShortDateString() @playbackHistory[i].PlaybackTime.ToShortTimeString()</span>
                            <button class="history-list-button" @onclick="() => OpenFile(playbackHistory[index])">
					        <i class="fa-solid fa-play"></i>
				        </button>
			        </div>
                    <MudDivider />
                }
            <MudButton Variant="Variant.Filled" @onclick="OnCleanHistory">
                <i class="fa-solid fa-trash mr-1"></i>
                <span class="ml-1">Clean history</span>
            </MudButton>
        }
    </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public string Id { get; set; }

    //TODO better alert system
    private bool _alert = true;
    private string _alertText = "";

    public MediaItem item;
    public List<MediaFile> currentFiles = new List<MediaFile>();
    public List<MediaFile> navigation = new List<MediaFile>();
    public List<ItemHistoryDto> playbackHistory = new();
    public MediaFile nextTrack = null;

    private SettingsModel _settings;
    private Debouncer _openFileDebouncer = new Debouncer(1000);

    protected override async Task OnInitializedAsync()
    {
        RefreshService.OnRefreshRequested += RefreshLoadMediaItem;
        _settings = await SettingsRepository.GetSettings();

        await InitialLoad();

        if(item.History is null) {
            item.History = new List<ItemHistory>();
        }
    }

    private async Task InitialLoad()
    {
        await LoadMediaItem();
        await OpenRootFolder();
        RefreshNextTrack();
    }

    public void Dispose()
    {
        RefreshService.OnRefreshRequested -= RefreshLoadMediaItem;
    }

    private async Task LoadMediaItem()
    {
        item = await MediaItemRepository.GetMediaItemFull(Guid.Parse(Id));
        if(!string.IsNullOrWhiteSpace(item?.ImagePath))
        {
            item.Image = await _imageRepository.LoadImage(item.ImagePath);
        }

        playbackHistory = MediaItemRepository.GetItemHistoryDtos(item!) ?? new List<ItemHistoryDto>();
    }

    private async Task RefreshLoadMediaItem(Guid itemId)
    {
        if(itemId != item.Id) return;

        await InvokeAsync(async () =>
        {
            await LoadMediaItem();
            StateHasChanged();
        });
    }

    public async Task OpenFolder(MediaFile folder) {
        await LoadFolder(folder);
        navigation.Add(folder);
    }

    public async Task OpenFolderFromNavigation(MediaFile folder)
    {
        await LoadFolder(folder);

        var currentIndex = navigation.FindIndex(n => n.Path == folder.Path);
        if (currentIndex == -1) return;

        for(var i = navigation.Count - 1; i > currentIndex; i--) {
            navigation.RemoveAt(i);
        }
    }

    public async Task ClickFile(MediaFile file)
    {
        if (file.Type == FileType.File)
            await OpenFile(file);
        else if (file.Type == FileType.Folder)
            await OpenFolder(file);
    }

    public string ItemWatchedStyle(MediaFile file)
    {
        if (playbackHistory is null) return string.Empty;

        if(file.Type == FileType.File)
        {
            return playbackHistory.Any(h => h.FileId == file.Id) ? "already-watched-title" : string.Empty;
        }

        return string.Empty; //TODO implement watched folders
    }

    private async Task OpenFile(ItemHistory historyItem)
    {
        await _openFileDebouncer.Debounce(async () =>
        {
            await MediaItemRepository.AddHistoryItem(item.Id, new ItemHistory
            {
                FileId = historyItem.FileId,
                PlaybackTime = DateTime.Now
            });
            await LaunchFile(item.Files.First(f => f.Id == historyItem.FileId));
            await LoadMediaItem();
        });
    }
    private async Task OpenFile(MediaFile file)
    {
        if (file.Id == null) return;

        await _openFileDebouncer.Debounce(async () =>
        {
            if (!_settings.UseInternalPlayer)
            {
                await MediaItemRepository.AddHistoryItem(item.Id, new ItemHistory
                    {
                        FileId = file.Id.Value,
                        PlaybackTime = DateTime.Now
                    });
            }

            await LaunchFile(file);
            await LoadMediaItem();
        });
    }

    private async Task LaunchFile(MediaFile file) {
        if(!File.Exists(file.Path))
        {
            Snackbar.Add($"File \"{Path.GetFileName(file.Path)}\" not found", Severity.Error);
            return;
        }

        if(_settings.UseInternalPlayer)
        {
            await PlayerService.OpenFile(file.Id!.Value);
        } else
        {
            try
            {
                _fileService.LaunchMediaFileDefault(file.Path);
            }
            catch (UnknownAssociatedProgramException e)
            {
                Snackbar.Add($"Program not found for extension: {e.Message}", Severity.Error);
            }
            catch (Exception e)
            {
                Snackbar.Add($"Unable to open file: {e.Message}", Severity.Error);
            }
        }
    }

    private async Task LoadFolder(MediaFile folder)
    {
        currentFiles = item.Files.GetFilesForDirectory(folder.Path).OrderBy(f => f.Title).ToList();
        await RecalculateTags();
    }

    public async Task OpenRootFolder() {
        currentFiles = item.Files.GetFilesForDirectory(item.FolderDirectory).OrderBy(f => f.Title).ToList();
        navigation = new List<MediaFile>();
        await RecalculateTags();
    }

    public async Task OpenAutoplaySetup()
    {
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Large };

        var parameters = new DialogParameters();
        parameters.Add("Item", item);

        var port = FileServer.EnsureServerRunning();
        parameters.Add("fileServerPort", port);

        var dialog = _dialogService.Show<SegmentsSetupDialog>("Setup intro/outro", parameters, options);
        await dialog.Result;
        FileServer.Dispose(); //TODO dispose on program exit/crash
    }

    private async Task RecalculateTags()
    {
        var files = currentFiles.Where(f => f.Type == FileType.File && f.FormatTags is null).ToList();
        if(!files.Any())
        {
            return;
        }

        var parsedTags = await ParseFilesTagsFromPaths(files.Select(f => f.Path).ToList());
        for (var i = 0; i < parsedTags?.Count; i++)
        {
            var file = files[i];
            var parsed = parsedTags[i];

            file.EpisodeTags = new List<string>();
            if (parsed.Seasons is not null)
            {
                file.EpisodeTags.Add($"Season {parsed.Seasons.FirstOrDefault()}");
            }
            if (parsed.Episodes is not null)
            {
                file.EpisodeTags.Add($"Episode {parsed.Episodes.FirstOrDefault()}"); 
            }

            file.FormatTags = new List<string>();
            if (!string.IsNullOrWhiteSpace(parsed.Resolution))
            {
                file.FormatTags.Add(parsed.Resolution);
            }
            if(!string.IsNullOrWhiteSpace(parsed.VideoCodec))
            {
                file.FormatTags.Add(parsed.VideoCodec);
            }
            file.FormatTags.Add(Path.GetExtension(file.Path));
        }

        foreach (var file in currentFiles)
        {
            file.ParseTitle();
        }

        StateHasChanged();
    }

    public void OnBack() {
        NavigationManager.NavigateTo("/");
    }

    public async void OnDelete()
    {
        var parameters = new DialogParameters();
        parameters.Add("ContentText", $"Do you really want to delete {item.Title}?");
        parameters.Add("ButtonText", "Delete");
        parameters.Add("Color", Color.Error);

        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = _dialogService.Show<CommonDialog>("Delete", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await MediaItemRepository.DeleteMediaItem(Guid.Parse(Id));
            OnBack();
        }
    }

    public async Task OnPlayNext()
    {
        if (nextTrack is not null)
        {
            await ClickFile(nextTrack);
        }
        RefreshNextTrack();
    }

    public async void OnCleanHistory()
    {
        await MediaItemRepository.DeleteHistoryAll(item.Id);
        playbackHistory = new List<ItemHistoryDto>();
        item.History = new List<ItemHistory>();
        item.RecalculatePlayedFiles(item.Files, false);
        RefreshNextTrack();
        StateHasChanged();
    }

    public void OpenFolderExplorer()
    {
        _nativeFolderService.OpenFolderInExplorer(item.FolderDirectory);
    }

    public async void RescanFolder()
    {
        item = await MediaItemService.RescanItem(item);

        //Reopen page
        await OpenRootFolder();
        StateHasChanged();
    }

    private void RefreshNextTrack()
    {
        try
        {
            nextTrack = item.GetNextMediaFile();
        }
        catch (Exception e)
        {
            //TODO handle
        }
    }

    private string GetFileIcon(FileType type)
    {
        return type switch
        {
            FileType.File => Icons.Material.Filled.Slideshow,
            FileType.Folder => Icons.Material.Filled.Folder,
            _ => ""
        };
    }

    //TODO dublicate
    private async Task<List<ParsedFilenameModel>> ParseFilesTagsFromPaths(List<string> paths)
    {
        var filenames = paths.Select(p => Path.GetFileName(p)).ToArray();
        try
        {
            return await JsRunTime.InvokeAsync<List<ParsedFilenameModel>>("FilenameParser.ParseFilename", new[] { filenames });
        }
        catch (Exception e)
        {
            //TODO log
            return null;
        }
    }

}
