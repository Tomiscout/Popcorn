<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="VideoBlazor">
          <!-- VideoBlazor files go here -->
          <Component Id="VideoBlazorExe" Guid="*">
            <File Id="VideoBlazorExeFile" Source=""<bind path='$(var.VideoBlazor.TargetPath)' />" KeyPath="yes" />
          </Component>

          <Directory Id="ChildDirectory" Name="VideoPlayer">
            <!-- VideoPlayer files go here -->
            <Component Id="VideoPlayerExe" Guid="*">
              <File Id="VideoPlayerExeFile" Source=""<bind path='$(var.VideoPlayer.TargetPath)' />" KeyPath="yes" />
            </Component>
            <Component Id="FFMpegComponent" Guid="*">
              <File Id="FFMpegFile" Source=""<bind path='$(var.ProjectDir)Path\To\ffmpeg.exe' />" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <ComponentGroup Id="ExampleComponents" Directory="INSTALLFOLDER">
      <ComponentRef Id="VideoBlazorExe" />
      <ComponentRef Id="VideoPlayerExe" />
      <ComponentRef Id="FFMpegComponent" />
    </ComponentGroup>
  </Fragment>
</Wix>
