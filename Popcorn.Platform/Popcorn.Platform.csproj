<Project Sdk="Microsoft.NET.Sdk">

  <!-- OS integration behind the Popcorn.Core interfaces, one folder per OS: player launching (+ the player link),
       folder/file pickers, file associations, process runner, autostart, tray icon. Plain net10.0 (Win32 calls, no
       WinForms) so the server keeps one target framework; the implementation is picked at run time
       (ServiceRegister.cs of the server / Popcorn.Player.Core). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Olbrasoft.SystemTray.Linux" />
    <PackageReference Include="Tmds.DBus.SourceGenerator">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Popcorn.Core\Popcorn.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Linux/DBusXml/com.canonical.dbusmenu.xml" DBusGeneratorMode="Handler" />
    <None Remove="Linux/tray.svg" />
    <Content Include="Linux/tray.svg" Link="tray.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Popcorn.Player.Windows\popcorn.ico" Link="popcorn.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
