<Window x:Class="Popcorn.Player.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:WPF="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Loaded="Window_Loaded"
        Title="Popcorn player" Height="650" Width="1000"
        
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        >

    <!-- WindowChrome for custom resizing and borderless window -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="10" GlassFrameThickness="0" CornerRadius="8,8,0,0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#FF3E3232" BorderThickness="2" Background="#FF3E3232">
        <!-- Content goes here, like WebView, MPV view, etc. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" x:Name="TitleBarRow"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="#FF271313" CornerRadius="4,4,0,0" Height="30" MouseDown="TitleBar_MouseDown" >
                <Grid>
                    <Image
                        Source="/popcorn.ico"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Height="17" Width="18" Margin="5,0,0,0" 
                    ></Image>
                    <TextBlock
                        Foreground="White"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="27,0,0,0" Height="17">
                        Popcorn
                    </TextBlock>

                    <Button
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Content="&#xEF2D;"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Width="60" Height="30" 
                        Cursor="Hand"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#FF656464"
                        Click="MinimizeButton_Click" Margin="0,0,116,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            >
                                    <ContentPresenter x:Name="contentPresenter" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FF4F2525"/>
                                        <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FFB34242"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Content="&#xEF2E;" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Width="60" Height="30" 
                        Cursor="Hand"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#FF655050"
                        Click="MaximizeRestoreButton_Click" Margin="0,0,58,0"
                        >
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                >
                                    <ContentPresenter x:Name="contentPresenter" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FF4F2525"/>
                                        <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FFB34242"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Content="&#xE8BB;" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Width="60" Height="30" 
                        Cursor="Hand"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#FF655050"
                        Click="CloseButton_Click"
                        >
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,4,0,0">
                                    <ContentPresenter x:Name="contentPresenter" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FFFF5555"/>
                                        <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FF0000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <WPF:WebView2 DefaultBackgroundColor="Transparent" x:Name="WebView" Grid.Row="1"/>
                <Border x:Name="MpvPlayerHostBorder" Background="Black" />
            </Grid>
        </Grid>
    </Border>
</Window>