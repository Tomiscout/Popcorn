<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:Popcorn.Player.Windows.Views"
    xmlns:viewModels="clr-namespace:Popcorn.Player.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="Popcorn.Player.Windows.Views.VideoPlayer"
>
	<v:MpvView x:Name="MpvView" Grid.Row="1" HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
	</v:MpvView>
</UserControl>