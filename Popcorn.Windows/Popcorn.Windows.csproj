<Project Sdk="Microsoft.NET.Sdk">

    <!-- Windows desktop app: one WebView2 window on Popcorn.Server's web UI (counterpart of the Rust/CEF Popcorn.Linux).
         Bundled into the server's folder, so keep its dependencies to WebView2 + the Serilog versions the server uses. -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>..\Popcorn.Player.Windows\popcorn.ico</ApplicationIcon>
        <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Web.WebView2" />
        <PackageReference Include="Serilog" />
    </ItemGroup>

    <ItemGroup>
        <!-- Same log file names as the other apps (Popcorn.Core itself isn't referenced, see Program.DataFolder). -->
        <Compile Include="..\Popcorn.Core\Shared\Logging\LogFileName.cs" Link="Logging\LogFileName.cs" />
        <Compile Include="..\Popcorn.Core\Shared\Logging\DailyLogFileSink.cs" Link="Logging\DailyLogFileSink.cs" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="wait.html" LogicalName="wait.html" />
        <EmbeddedResource Include="..\Popcorn.Linux\popcorn.png" LogicalName="popcorn.png" />
        <EmbeddedResource Include="..\Popcorn.Web\public\images\pop_1.png" LogicalName="kernel.png" />
    </ItemGroup>

    <ItemGroup>
        <!-- Ends up in the bundle/install folder; registered as the app's uninstaller by install_windows.ps1. -->
        <None Update="uninstall.ps1" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
