<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VideoPlayerAvalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="using:VideoPlayerAvalonia.VLC"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="VideoPlayerAvalonia.Views.MainWindow"
		Opened="OnOpened"
        Icon="/Assets/avalonia-logo.ico"
        Title="VideoPlayerAvalonia">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

	<Grid>
		<vlc:VideoView Grid.Row="0" MediaPlayer="{Binding MediaPlayer}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

	<Grid Grid.Row="0" IsVisible="False">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<StackPanel>

			</StackPanel>
			<Grid Grid.Row="1" Height="100">
				<Grid.RowDefinitions>
					<RowDefinition Height="20" />
					<RowDefinition Height="20" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<Slider Grid.Row="1" Maximum="100" />

				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="64" />
						<ColumnDefinition Width="64" />
						<ColumnDefinition Width="64" />
						<ColumnDefinition Width="64" />
						<ColumnDefinition />
						<ColumnDefinition Width="64" />
						<ColumnDefinition Width="64" />
						<ColumnDefinition Width="64" />
						<ColumnDefinition Width="64" />
						<ColumnDefinition Width="64" />
					</Grid.ColumnDefinitions>
					<Grid.Styles>
						<Style Selector="TextBlock">
							<Setter Property="FontFamily" Value="Helvetica"/>
						</Style>
						<Style Selector="Button">
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="Margin" Value="8" />
							<Setter Property="Padding" Value="2" />
						</Style>
						<!--<Style Selector="Button /template/ ContentPresenter">
							<Setter Property="Transitions">
								<Transitions>
									<TransformOperationsTransition Property="RenderTransform" Easing="BackEaseInOut" Duration="0:0:0.1" />
								</Transitions>
							</Setter>
						</Style>-->
						<Style Selector="Button:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="RenderTransform" Value="scale(1.11)"/>
						</Style>
						<Style Selector="Button:pressed /template/ ContentPresenter">
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="RenderTransform" Value="scale(0.9)"/>
						</Style>
					</Grid.Styles>

					<Button x:Name="PlayBtn" Grid.Column="0" Click="Play_Clicked">
						<Image Source="{SvgImage /Assets/Icons/play.svg}" />
					</Button>
					<Button x:Name="StopBtn" Grid.Column="0" Click="Play_Clicked">
						<Image Source="{SvgImage /Assets/Icons/stop.svg}" />
					</Button>

					<Button Grid.Column="1" Click="Play_Clicked">
						<Image Source="{SvgImage /Assets/Icons/10-back.svg}" />
					</Button>

					<Button Grid.Column="2" Click="Play_Clicked">
						<Image Source="{SvgImage /Assets/Icons/10-forward.svg}" />
					</Button>

					<Button Grid.Column="3" Click="Play_Clicked">
						<Image Source="{SvgImage /Assets/Icons/sound-mute.svg}" />
					</Button>
					
					<Button Grid.Column="3" Click="Play_Clicked">
						<Image Source="{SvgImage /Assets/Icons/sound-min.svg}" />
					</Button>
					<Button Grid.Column="3" Click="Play_Clicked">
						<Image Source="{SvgImage /Assets/Icons/sound-med.svg}" />
					</Button>
					<Button Grid.Column="3" Click="Play_Clicked">
						<Image Source="{SvgImage /Assets/Icons/sound-max.svg}" />
					</Button>

					<StackPanel Grid.Column="4" HorizontalAlignment="Center" Orientation="Horizontal">
						<TextBlock Margin="0 0 5 0">Narutoo</TextBlock>
						<TextBlock Margin="0 0 7 0">EP 275</TextBlock>
						<TextBlock>Bowlcut faints and cries</TextBlock>
					</StackPanel>
			
				</Grid>
			</Grid>
		</Grid>
		<!---->
	</Grid>
</Window>
