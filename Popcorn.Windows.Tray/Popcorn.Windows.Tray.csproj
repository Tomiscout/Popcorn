<Project Sdk="Microsoft.NET.Sdk">

    <!-- Plain net10.0 (Win32 calls, no WinForms) so Popcorn.Server keeps one target framework on every OS. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Popcorn.Shared\Popcorn.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Popcorn.Player.Windows\popcorn.ico" Link="popcorn.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
